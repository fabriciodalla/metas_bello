# ─── PostgreSQL ────────────────────────────
POSTGRES_DB=metas_bello
POSTGRES_USER=metas
POSTGRES_PASSWORD=metas
POSTGRES_HOST_PORT=5432

# ─── API (FastAPI) ─────────────────────────
API_HOST_PORT=8000
