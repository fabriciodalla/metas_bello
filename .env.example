POSTGRES_DB=metasbello
POSTGRES_USER=metasbello
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5432
WEB_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# "backend" é necessário: o proxy do Vite (frontend) reescreve o Host para o alvo interno.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

DATABASE_URL=postgres://metasbello:change-me@db:5432/metasbello

# Postgres externo do histórico de vendas — somente leitura (ver docs/architecture.md,
# Anticorruption Layer). Deixe em branco enquanto não configurado; nada tenta conectar sem isso.
SALES_HISTORY_DATABASE_URL=
