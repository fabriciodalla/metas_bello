# Variáveis para a stack de produção (docker-compose.prod.yml). No Coolify, o painel grava essas
# variáveis direto em `.env` no diretório do projeto — não precisa copiar nada manualmente. Para
# rodar a stack de produção localmente (fora do Coolify), copie este arquivo para `.env` no mesmo
# diretório do docker-compose.prod.yml (não confundir com o `.env` do docker-compose.yml de
# desenvolvimento — não rode os dois a partir do mesmo diretório ao mesmo tempo).

POSTGRES_DB=metasbello
POSTGRES_USER=metasbello
# Sem valor padrão de propósito — o compose de produção recusa subir sem isso definido (M-04).
POSTGRES_PASSWORD=

# Gere um valor próprio, nunca reaproveite o de desenvolvimento. Evite "$" no resultado — o
# Compose interpola "$VAR" dentro do próprio arquivo de env, e um "$" solto na chave (ou em
# qualquer senha aqui) vira uma variável indefinida em vez do caractere literal:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
# Mantenha "backend" (não o domínio público) — o nginx já reescreve o Host pro alvo interno antes
# de repassar pro Django (ver frontend/nginx.conf), igual o proxy do Vite faz em dev.
DJANGO_ALLOWED_HOSTS=backend
# Aqui SIM precisa ser a origem pública de verdade (CSRF valida Origin/Referer do navegador, não
# o Host reescrito) — liste todo endereço pelo qual alguém acessa de fato, separado por vírgula.
# Ambiente atual (Coolify + Traefik, sempre HTTPS): use a(s) origem(ns) https:// reais do domínio
# publicado, ex.: https://metas.bello.com.br — sem isso preenchido corretamente, login quebra por
# CSRF 403 mesmo com DJANGO_SECURE_COOKIES=True.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Só entra True por padrão fora de DEBUG (settings.py) — o que exige HTTPS pro cookie de
# sessão/CSRF ser aceito pelo navegador. Ambiente atual é sempre HTTPS (Traefik na frente,
# certificado válido) — deixe True (ou omita a variável: o padrão já é `not DEBUG`). Ativar isso
# também liga HSTS por 1 ano (settings.py) — só habilite depois de confirmar que o HTTPS/domínio
# está estável, porque o navegador passa a recusar HTTP nesse domínio pelo mesmo período.
DJANGO_SECURE_COOKIES=True

# Repita aqui a mesma senha de POSTGRES_PASSWORD acima — o compose não interpola variáveis dentro
# do próprio arquivo passado via `env_file` (mesma convenção já usada em .env.example).
DATABASE_URL=postgres://metasbello:<mesma-senha-do-POSTGRES_PASSWORD>@db:5432/metasbello

# Postgres externo do histórico de vendas (somente leitura, ver docs/architecture.md). Em branco,
# nenhum alias de banco é registrado e nada tenta conectar — não dá erro, mas a sugestão automática
# (P1-P4) roda sobre baseline vazio (zerado), degradando a funcionalidade central da cascata
# Gerente→Vendedor sem avisar ninguém. Antes do deploy, confirmar:
#   1. A integração é necessária em produção, ou a aplicação vai operar sem ela por ora?
#   2. Se necessária: este servidor alcança o Postgres do histórico (pode exigir liberação do TI)?
#   3. As credenciais de leitura já existem?
# Testar a conectividade a partir da VPS antes de publicar. Além disso, `sync_sales_history` /
# `rebuild_distribution_baseline` (management commands em apps/sales_history) precisam de um
# agendamento (cron no host ou task do Coolify) neste ambiente — não há serviço de cron no
# docker-compose.prod.yml, isso é um passo à parte, fora desta stack.
SALES_HISTORY_DATABASE_URL=

DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=naoresponda@bello.local

# URL pública usada para montar o link de "definir senha" enviado por e-mail — uma das origens de
# DJANGO_CSRF_TRUSTED_ORIGINS, sem wildcard (ex.: https://metas.bello.com.br).
FRONTEND_URL=

# Administrador inicial — lidas pelo management command `create_admin`, que NÃO roda no
# entrypoint: precisa ser disparado à mão uma vez, depois do primeiro deploy
# (`docker compose exec backend python manage.py create_admin`). No entrypoint, a senha seria
# reescrita a cada reinício do contêiner, revertendo qualquer troca feita pela interface.
# Sem as três definidas o comando falha sem criar nada, de propósito.
# ADMIN_NAME é o nome completo da pessoa (vai para `username`) — o validador rejeita números.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
