# Variáveis para a stack de produção (docker-compose.prod.yml) — copie para `.env.prod` e
# preencha antes de subir. Não tem relação com o `.env` do docker-compose.yml de desenvolvimento.

POSTGRES_DB=metasbello
POSTGRES_USER=metasbello
# Sem valor padrão de propósito — o compose de produção recusa subir sem isso definido (M-04).
POSTGRES_PASSWORD=

# Porta publicada pelo nginx (serve o frontend + proxy da API) — é nela que o túnel/reverse proxy
# externo deve apontar. 8084: porta já redirecionada pelo TI pro servidor compartilhado
# (10.160.3.136) — mudar aqui exige pedir um redirecionamento novo pra outra porta.
FRONTEND_HOST_PORT=8084

# Gere um valor próprio, nunca reaproveite o de desenvolvimento. Evite "$" no resultado — o
# Compose interpola "$VAR" dentro do próprio arquivo de env, e um "$" solto na chave (ou em
# qualquer senha aqui) vira uma variável indefinida em vez do caractere literal:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
# Mantenha "backend" (não o domínio público) — o nginx já reescreve o Host pro alvo interno antes
# de repassar pro Django (ver frontend/nginx.conf), igual o proxy do Vite faz em dev.
DJANGO_ALLOWED_HOSTS=backend
# Aqui SIM precisa ser a origem pública de verdade (CSRF valida Origin/Referer do navegador, não
# o Host reescrito) — liste todo endereço pelo qual alguém acessa de fato, separado por vírgula.
# Sem túnel/HTTPS (decisão 2026-09-16: acesso direto por IP:porta), é algo como:
#   http://<ip-externo>:8084,http://<ip-interno-do-servidor>:8084
# Se um dia migrar pra túnel Cloudflare: https://seu-tunel.trycloudflare.com (ou
# "https://*.trycloudflare.com" se o subdomínio mudar a cada sessão — Django aceita wildcard de
# primeiro nível).
DJANGO_CSRF_TRUSTED_ORIGINS=
# Só entra True por padrão fora de DEBUG (settings.py) — o que exige HTTPS pro cookie de
# sessão/CSRF ser aceito pelo navegador. Sem túnel/HTTPS na frente (acesso HTTP puro por
# IP:porta), deixe False, senão o login quebra silenciosamente (cookie Secure nunca chega).
DJANGO_SECURE_COOKIES=False

# Repita aqui a mesma senha de POSTGRES_PASSWORD acima — o compose não interpola variáveis dentro
# do próprio arquivo passado via `env_file` (mesma convenção já usada em .env.example).
DATABASE_URL=postgres://metasbello:<mesma-senha-do-POSTGRES_PASSWORD>@db:5432/metasbello

SALES_HISTORY_DATABASE_URL=

DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=naoresponda@bello.local

# URL pública usada para montar o link de "definir senha" enviado por e-mail — uma das origens de
# DJANGO_CSRF_TRUSTED_ORIGINS, sem wildcard (ex.: http://<ip-externo>:8084).
FRONTEND_URL=
